# Runtime
NODE_ENV=development
PORT=4000

# Database (LOCAL is tried first, then CLOUD)
LOCAL_MONGODB_URL=mongodb://127.0.0.1:27017/letshop
# CLOUD_MONGODB_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/letshop

# Auth and URLs
JWT_SECRET=replace-with-a-long-random-secret
BASE_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional admin seeding data (createAdmin is commented out by default)
ADMIN_EMAIL=admin@example.com
ADMIN_PWD=AdminPassw0rd!
ADMIN_NAME=Admin
ADMIN_ADDRESS=Morocco
ADMIN_PHONE=0600000000

# Email (Gmail App Password, not your normal password)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-gmail-app-password
CONTACT_EMAIL=your-email@gmail.com

# Cloudinary
CLOUDINARY_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
